{
  "name": "creditagricole/etransactions",
  "description": "Etransactions payment module for Magento 2.3/2.4",
  "type": "magento2-module",
  "version": "2.0.12",
  "license": [
    "OSL-3.0",
    "AFL-3.0"
  ],
  "require": {
    "php": "~7.4.0||~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0"
  },
  "autoload": {
    "files": [ "registration.php" ],
    "psr-4": {
      "CreditAgricole\\Etransactions\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
